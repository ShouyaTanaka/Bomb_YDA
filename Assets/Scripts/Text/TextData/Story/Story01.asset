  texts:
  - Name: 
    Content: "\u500B\u6027\u8C4A\u304B\u306A\u751F\u5F92\u305F\u3061\u304C\u96C6\u307E\u308A\u3001\u65E5\u3005\u3001\u7206\u5F3E\u89E3\u9664\u306B\u5FC5\u8981\u306A\u77E5\u8B58\u3068\u6280\u8853\u3092\u5B66\u3093\u3067\u3044\u308B\u3002"
  - Name: 
    Content: "\u305D\u3093\u306A\u4E2D\u3067\u3001\u4E16\u9593\u3092\u9A12\u304C\u305B\u3066\u3044\u308B\u4E8B\u4EF6\u304C\u3042\u3063\u305F\u3002"
  - Name: 
    Content: "\u5404\u5730\u3067\u76F8\u6B21\u3044\u3067\u767A\u751F\u3057\u3066\u3044\u308B\u3001\u8B0E\u306E\u9023\u7D9A\u7206\u7834\u4E8B\u4EF6\u2015\u2015\u3002"
  - Name: 
    Content: "SNS\u3084\u30C6\u30EC\u30D3\u3067\u306F\u9023\u65E5\u3001\u4E8B\u4EF6\u304C\u5831\u9053\u3055\u308C\u3001\u72AF\u4EBA\u306F\u3044\u307E\u3060\u6355\u307E\u3063\u3066\u3044\u306A\u3044\u3002"
