  texts:
  - Name: 
    Content: "\u4ECA\u304B\u3089\u8077\u54E1\u5BA4\u3078\u5148\u751F\u3092\u547C\u3073\u306B\u884C\u3063\u305F\u308A\u3001\u8B66\u5BDF\u3078\u901A\u5831\u3057\u305F\u308A\u3057\u3066\u3044\u308B\u6642\u9593\u306F\u306A\u3044\u3002"
  - Name: 
    Content: "\u7206\u5F3E\u306E\u30BF\u30A4\u30DE\u30FC\u306F\u3001\u523B\u4E00\u523B\u3068\u6642\u9593\u3092\u6E1B\u3089\u3057\u3066\u3044\u308B\u3002"
  - Name: 
    Content: "\u307E\u305A\u3044\u2026\u2026\u3053\u306E\u307E\u307E\u3058\u3083\u5B66\u6821\u304C\u2026\u2026\uFF01"
  - Name: 
    Content: "\u30BF\u30A4\u30DE\u30FC\u304C\uFF10\u306B\u306A\u308B\u524D\u306B\u3001\u76EE\u306E\u524D\u306E\u7206\u5F3E\u3092\u64CD\u4F5C\u3057\u3066\u3001\u7206\u5F3E\u3092\u89E3\u9664\u305B\u3088\uFF01"
