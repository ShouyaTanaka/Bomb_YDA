  texts:
  - Name: "\u8B0E\u306E\u7537"
    Content: "\u307B\u3046\u3001\u307E\u3055\u304B\u672C\u5F53\u306B\u30BF\u30A4\u30DE\u30FC\u3092\u6B62\u3081\u3066\u898B\u305B\u308B\u3068\u306F\u306A\u3002"
