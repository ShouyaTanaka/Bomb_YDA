  m_Name: GoodEnd
  m_EditorClassIdentifier: Assembly-CSharp::SectionData
  texts:
  - Name: 
    Content: "\u7121\u4E8B\u3001\u7206\u5F3E\u306E\u89E3\u9664\u306B\u6210\u529F\u3057\u305F\u3042\u306A\u305F\u306B\u306F\u3001\u56FD\u3068\u5B66\u6821\u304B\u3089\u611F\u8B1D\u72B6\u304C\u8D08\u3089\u308C\u305F\u3002"
  - Name: 
    Content: "\u4ECA\u56DE\u306E\u4E8B\u4EF6\u3092\u5F15\u304D\u8D77\u3053\u3057\u305F\u306E\u306F\u3001\u731F\u5947\u7684\u306A\u9023\u7D9A\u7206\u767A\u4E8B\u4EF6\u3092\u7E70\u308A\u8FD4\u3057\u3066\u3044\u305F\u72AF\u884C\u30B0\u30EB\u30FC\u30D7\u300CBomber\u300D\u3060\u3063\u305F\u3002"
  - Name: 
    Content: "\u3042\u306A\u305F\u306F\u305D\u306E\u30EA\u30FC\u30C0\u30FC\u304C\u4ED5\u639B\u3051\u305F\u7206\u5F3E\u3092\u89E3\u9664\u3057\u3001\n\u5F7C\u306E\u8A08\u753B\u3092\u963B\u6B62\u3057\u305F\u3053\u3068\u3067\u3001\u4E16\u9593\u3092\u9A12\u304C\u305B\u3066\u3044\u305F\u4E00\u9023\u306E\u4E8B\u4EF6\u306F\u5E55\u3092\u9589\u3058\u308B\u3053\u3068\u3068\u306A\u308B\u3002"
  - Name: 
    Content: "\u4E3B\u5C0E\u8005\u3092\u5931\u3063\u305F\u300CBomber\u300D\u3082\u6B21\u3005\u3068\u902E\u6355\u3055\u308C\u3001\u307B\u3069\u306A\u304F\u3057\u3066\u89E3\u6563\u3002\u9577\u304F\u7D9A\u3044\u305F\u4E8B\u4EF6\u306F\u3001\u3088\u3046\u3084\u304F\u7D42\u308F\u308A\u3092\u8FCE\u3048\u305F\u3002"
  - Name: 
    Content: "\u3053\u306E\u529F\u7E3E\u306F\u5730\u57DF\u306E\u65B0\u805E\u3084\u30C6\u30EC\u30D3\u3067\u3082\u5927\u304D\u304F\u53D6\u308A\u4E0A\u3052\u3089\u308C\u3001\u3042\u306A\u305F\u306F\u77AC\u304F\u9593\u306B\u6642\u306E\u4EBA\u3068\u306A\u3063\u305F\u3002"
  - Name: 
    Content: "\u3053\u306E\u529F\u7E3E\u306F\u5730\u57DF\u306E\u65B0\u805E\u3084\u30C6\u30EC\u30D3\u3067\u3082\u5927\u304D\u304F\u53D6\u308A\u4E0A\u3052\u3089\u308C\u3001\u3042\u306A\u305F\u306F\u77AC\u304F\u9593\u306B\u6642\u306E\u4EBA\u3068\u306A\u3063\u305F\u3002"
  - Name: 
    Content: "\u305D\u306E\u65E5\u3001\u3042\u306A\u305F\u306F\u8AB0\u3082\u304C\u77E5\u308B\u82F1\u96C4\u306B\u306A\u3063\u305F\u306E\u3060\u3063\u305F\u3002"
