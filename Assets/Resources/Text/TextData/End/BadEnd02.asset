  texts:
  - Name: BadEnd02
    Content: "\u5207\u65AD\u3059\u3079\u304D\u914D\u7DDA\u3092\u9593\u9055\u3048\u305F\u3002"
  - Name: BadEnd02
    Content: "\u305D\u306E\u77AC\u9593\u3001\u88C5\u7F6E\u304B\u3089\u77ED\u3044\u96FB\u5B50\u97F3\u304C\u9CF4\u308A\u3001\u30BF\u30A4\u30DE\u30FC\u306E\u6570\u5B57\u304C\u6D88\u3048\u308B\u3002"
  - Name: BadEnd02
    Content: "\u5468\u56F2\u306B\u3044\u305F\u5168\u54E1\u304C\u7206\u767A\u3092\u899A\u609F\u3057\u3001\u5484\u55DF\u306B\u76EE\u3092\u9589\u3058\u308B\u3002"
  - Name: BadEnd02
    Content: "\u2015\u2015\u3057\u304B\u3057\u3001\u3044\u3064\u307E\u3067\u7D4C\u3063\u3066\u3082\u4F55\u3082\u8D77\u3053\u3089\u306A\u3044\u3002"
  - Name: BadEnd02
    Content: "\u6050\u308B\u6050\u308B\u76EE\u3092\u958B\u3051\u305F\u305D\u306E\u6642\u3060\u3063\u305F\u3002"
