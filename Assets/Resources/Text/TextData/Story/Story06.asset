  texts:
  - Name: 
    Content: "\u30BF\u30A4\u30DE\u30FC\u306E\u30AB\u30A6\u30F3\u30C8\u306F\u6B62\u307E\u308A\u3001\u80F8\u3092\u306A\u3067\u304A\u308D\u3059\u3002\r\n\u3057\u304B\u3057\u3001\u4F55\u304B\u304C\u304A\u304B\u3057\u3044\u3002"
  - Name: 
    Content: "\u30BF\u30A4\u30DE\u30FC\u306F\u6B62\u307E\u3063\u3066\u3044\u308B\u306F\u305A\u306A\u306E\u306B\u30AB\u30C1\u30AB\u30C1\u3068\u3044\u3046\u6642\u304C\u9032\u3093\u3067\u3057\u307E\u3046\u5ACC\u306A\u97F3\u304C\u6B62\u307E\u3089\u306A\u3044\u306E\u3060\u3002"
  - Name: 
