  state: 10
  texts:
  - Name: 
    Content: "\u6559\u5BA4\u306E\u4E2D\u592E\u306B\u7F6E\u304B\u308C\u3066\u3044\u305F\u306E\u306F\u3001\u898B\u6163\u308C\u306A\u3044\u7206\u5F3E\u3068\u3001\u3044\u304F\u3064\u3082\u306E\u88C5\u7F6E\u3002"
  - Name: 
    Content: "\u3053\u308C\u306F\u307E\u3055\u304B...\uFF01"
  - Name: 
    Content: "\u4E00\u77AC\u3001\u8A00\u8449\u3092\u5931\u3046\u3002\r\n\u3059\u3050\u306B\u5148\u751F\u3078\u77E5\u3089\u305B\u306A\u3051\u308C\u3070\u2015\u2015\u3002"
  - Name: 
    Content: "\u305D\u3046\u3057\u3066\u8077\u54E1\u5BA4\u306B\u5411\u304B\u3063\u305F\u3001\u305D\u306E\u6642\u3060\u3063\u305F\u3002"
  - Name: 
    Content: "\uFF08\u3053\u3053\u304B\u3089\u5B9F\u969B\u306E\u96FB\u8A71\uFF09\n\uFF08\u53D7\u8A71\u5668\u3092\u7F6E\u3044\u305F\u3089\u6B21\u306E\u30C6\u30AD\u30B9\u30C8\uFF09"
  - Name: 
    Content: "\u4ECA\u304B\u3089\u8077\u54E1\u5BA4\u3078\u5148\u751F\u3092\u547C\u3073\u306B\u884C\u3063\u305F\u308A\u3001\u8B66\u5BDF\u3078\u901A\u5831\u3057\u305F\u308A\u3057\u3066\u3044\u308B\u6642\u9593\u306F\u306A\u3044\u3002"
  - Name: 
    Content: "\u307E\u305A\u3044\u2026\u2026\u3053\u306E\u307E\u307E\u3058\u3083\u5B66\u6821\u304C\u2026\u2026\uFF01"
  - Name: 
    Content: "\u30BF\u30A4\u30DE\u30FC\u304C\uFF10\u306B\u306A\u308B\u524D\u306B\u3001\u76EE\u306E\u524D\u306E\u8B0E\u3092\u89E3\u304D\u3001\u7206\u5F3E\u3092\u89E3\u9664\u305B\u3088\uFF01"
