  texts:
  - Name: 
    Content: "\u89E3\u9664\u304C\u9593\u306B\u5408\u308F\u305A\u3001\u30BF\u30A4\u30DE\u30FC\u306F\uFF10\u306B\u306A\u3063\u305F\u3002"
